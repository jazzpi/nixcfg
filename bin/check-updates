#!/usr/bin/env bash
set -euo pipefail

FLAKE_DIR="$(realpath "$(dirname "$(realpath "$0")")/..")"
TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

cp "$FLAKE_DIR/flake.nix" "$TMP_DIR/"
cp "$FLAKE_DIR/flake.lock" "$TMP_DIR/"

nix flake update --flake "$TMP_DIR" 2>&1 |
    awk '
    /Updated input/ {
        match($0, /'"'"'([^'"'"']+)'"'"'/, a)
        name = a[1]
    }
    /\(20[0-9-]+\)/ && !/→/ {
        match($0, /\(([0-9-]+)\)/, d)
        current_date = d[1]
    }
    /→.*\(20[0-9-]+\)/ {
        match($0, /\(([0-9-]+)\)/, d)
        slash = index(name, "/")
        if (slash == 0) {
            top[name] = current_date " -> " d[1]
            if (!(name in seen)) {
                seen[name] = 1
                order[++n] = name
            }
        } else {
            root = substr(name, 1, slash - 1)
            transitive[root]++
        }
    }
    END {
        for (i = 1; i <= n; i++) {
            nm = order[i]
            line = nm " " top[nm]
            if (transitive[nm] > 0) {
                line = line "(+" transitive[nm] "t)"
            }
            print line
        }
    }
    '
